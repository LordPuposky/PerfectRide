@using System.Security.Claims
@using PerfectRide.Data
@using PerfectRide.Services
@using System
@using System.Globalization
@using PerfectRide.Helpers


@inject VehicleService VehicleService
@inject MaintenanceService MaintenanceService
@inject MaintenanceScheduleService MaintenanceScheduleService
@inject MileageTrackingService MileageTrackingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ScheduledServicesHelper ScheduleServicesHelper
@inject ILogger<MaintenanceCard> Logger

@* Card Header *@
<div class="card dashboard-card maintenance-dashboard-card shadow-sm">
    <div class="card-body">
        <div class="dashboard-card-heading">
            <div>
                <p class="dashboard-card-eyebrow">Service</p>
                <h2 class="card-title">Maintenance</h2>
            </div>
            <a class="dashboard-card-action" href="/authenticated/maintenance">View maintenance <span aria-hidden="true">&rarr;</span></a>
        </div>
        @* Show Loading State *@
        @if (_isLoading)
        {
            <p>Loading Maintenance Summary...</p>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_errorMessage</p>
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RetryAsync">Try again</button>
            </div>
        }
        else
        {
                <div>
                        <a href="/authenticated/maintenance" class="maintenance-card mb-3">
                            <div class="maintenance-card-header">
                            @{
                                (int numServices, int vehiclesServiced, decimal totalCost, decimal averageCost) = CalculateServicesStatistics(365);
                            }
                            <strong>Maintenance Overview</strong>
                            </div>

                            @* Render Overdue services *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info @(_overdueServicesCount > 0 ? "maintenance-info-alert" : "")">
                                <strong>@_overdueServicesCount</strong>
                                <strong>Overdue Services</strong>
                                <p>Services requiring immediate attention</p>
                                </div>
                            </div>

                            @* Render upcoming Services *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                <strong>@_upcomingServicesCount</strong>
                                <strong>Upcoming Services</strong>
                                <p>Services approaching</p>
                                </div>
                            </div>

                            @* Render maintenance Summary across all vehicles *@
                            <div class="maintenance-card-header">
                            <strong>Maintenance Summary</strong>
                            </div>

                            @* Render the number of services performed across all vehicles *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                    <div>
                                        <p>Period</p>
                                        <p>This Year</p>
                                    </div>
                                <strong>@numServices</strong>
                                <strong>Services performed</strong>
                                </div>
                            </div>

                            @* Render the number of vehicles serviced *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                <strong>@vehiclesServiced</strong>
                                <strong>Vehicles Serviced</strong>
                                </div>
                            </div>

                            @* Render the total cost for vehicle maintenance *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                <strong>
                                    @totalCost.ToString("C", CultureInfo.GetCultureInfo("en-US"))
                                    </strong>
                                <strong>Total Maintenance Cost</strong>
                                </div>
                            </div>

                            @* Render average cost per service *@
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                <strong>
                                    @averageCost.ToString("C", CultureInfo.GetCultureInfo("en-US"))
                                </strong>
                                <strong>Average Cost per Service</strong>
                                </div>
                            </div>

                            @* Render recent maintenance items performed *@
                            <div class="maintenance-card-header">
                            <strong>Vehicle Maintenance Needed</strong>
                            </div>
                            
                            <div class="maintenance-card-body">
                                <div class="maintenance-info">
                                    <RecentMaintenanceCard UpcomingServices="_upcomingServices" UserVehicles="_userVehicles" OverdueServices="_overdueServices" />
                                </div>
                            </div>
                        </a>
                </div>
            }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<List<string>> OnMessagesGenerated { get; set;  }
    public List<string> _maintenanceMessages = new(); 
    private List<Vehicle> _userVehicles = new();
    private bool _isLoading = true;
    private List<MaintenanceSchedule> _userMaintenanceSchedule = new(); 
    private List<MaintenanceSchedule> _overdueServices = new();
    private List<MaintenanceSchedule> _upcomingServices = new();
    private int _overdueServicesCount = 0;
    private int _upcomingServicesCount = 0;
    private List<MaintenanceRecord> _maintenanceRecords = new();
    private List<MileageTracking> _mileageTrackings = new(0);
    private string? _errorMessage;
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task RetryAsync()
    {
        await LoadAsync();
    }

    @* Gathers all needed information from Services and initializes variables with needed information. *@
    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _maintenanceRecords.Clear();
        _overdueServices.Clear();
        _upcomingServices.Clear();
        _maintenanceMessages.Clear();
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            @* Verifies the session belongs to a valid logged in user *@
            if (string.IsNullOrWhiteSpace(userId))
            {
                _errorMessage = "Unable to verify your account. Please sign in again.";
                return;
            }

            @* Retrieves mileage, vehicle, MileageTracking, and user maintenance schedules from DB and stores in local variables. *@
            Dictionary<int,int> vehicleCurrentMileages = await MileageTrackingService.GetCurrentMileageByUser(userId); 
            _userVehicles = await VehicleService.GetVehiclesAsync(userId);
            _mileageTrackings = await MileageTrackingService.GetMileageTrackingsByUser(userId);
            _userMaintenanceSchedule = await MaintenanceScheduleService.GetMaintenanceScheduleForUser(userId); 

            @* Loops through each vehicle to 
                * Retrieve Maintenance records associated with the vehicle
                * Retrieve overdue services and count for each vehicle
                * Retrieve upcoming services and cound for each vehicle 
              Stores this information in local variables. *@
            foreach (Vehicle v in _userVehicles)
            {

                List<MaintenanceRecord> vehicleRecords = new List<MaintenanceRecord>();  
                vehicleRecords= await MaintenanceService.GetRecordsForVehicleAsync(v.Id, userId);
                _maintenanceRecords.AddRange(vehicleRecords);
            }
            (
                _overdueServicesCount,
                _overdueServices, 
                _upcomingServicesCount,
                _upcomingServices) = await ScheduleServicesHelper.CalculateScheduledServices(
                _userMaintenanceSchedule, 
                _maintenanceRecords, 
                _mileageTrackings, 
                vehicleCurrentMileages);

            @* Generates maintenance messages for the Message Banner and starts the Banner*@
            await GenerateMaintenanceMessages(); 
            await OnMessagesGenerated.InvokeAsync(_maintenanceMessages);
        }

        @*Error handling for Message Banner *@
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load dashboard maintenance data.");
            _errorMessage = "We couldn't load your maintenance summary. Please try again.";
            _maintenanceMessages.Clear();
            await OnMessagesGenerated.InvokeAsync(_maintenanceMessages);
        }
        @* Ensures page is still loaded without banner if Message Banner fails *@
        finally
        {
            _isLoading = false;
        }
    }

    @* Uses data collected from server to calculate: 
         *count of vehicles serviced 
         *count of services performed
         *total cost of services performed
         *average cost of services performed
      Saves this information into local variables. *@
    (int, int, decimal, decimal) CalculateServicesStatistics (int periodLength)
    {
        DateOnly today = DateOnly.FromDateTime(DateTime.Now);
        DateOnly beginningDate = today.AddDays(-(periodLength));

        List<MaintenanceRecord> relevantRecords = new();
        relevantRecords = _maintenanceRecords
        .Where(r => r.DatePerformed >= beginningDate)
        .OrderByDescending(r => r.DatePerformed)
        .ToList(); 

        int serviceCount = relevantRecords.Count(); 

        int vehicleCount = relevantRecords
        .Select(r => r.VehicleId)
        .Distinct()
        .Count(); 

        decimal totalCost = 0; 
        decimal averageCost = 0;
        int maintenanceCount = 0; 

        if (relevantRecords.Count() > 0)
        {
            foreach (MaintenanceRecord r in relevantRecords)
            {
                totalCost += r.Cost ?? 0;
                maintenanceCount +=1; 
            }
            averageCost = totalCost/maintenanceCount; 

        }

        return (serviceCount, vehicleCount, totalCost, averageCost); 

    }


@* Determines messages to display in the Banner.  
   Displays Overdue services if present. 
   Displays upcoming services if no services are overdue.
   Displays  *@
private async Task GenerateMaintenanceMessages()
{
    _maintenanceMessages.Clear();

    @* Determines whether to display overdue or upcoming services *@
    List<MaintenanceSchedule> servicesToDisplay =
        _overdueServices.Count > 0
            ? _overdueServices
            : _upcomingServices;

    @* Builds a string for each selected service and stores it in the messages local variable  *@
    foreach (MaintenanceSchedule schedule in servicesToDisplay)
    {
        Vehicle? vehicle = _userVehicles
            .FirstOrDefault(v => v.Id == schedule.VehicleId);

        if (vehicle == null)
            continue;

        string vehicleName =
            $"{vehicle.Year} {vehicle.Make} {vehicle.Model}";
        string serviceName = schedule.MaintenanceItem == MaintenanceItem.Other
            ? schedule.Description ?? "Other Maintenance"
            : DisplayNameHelper.ToDisplayName(schedule.MaintenanceItem);

        string status = _overdueServices.Contains(schedule)
            ? "is overdue"
            : "is coming due soon";

        _maintenanceMessages.Add(
            $"{vehicleName}: {serviceName} {status}.");
    }
    @* Displays a default message if there are no overdue or upcoming maintenance items. *@
    if (_maintenanceMessages.Count == 0)
    {
        _maintenanceMessages.Add(
            "Your vehicles are up to date on scheduled maintenance!");
    }
}


   
}