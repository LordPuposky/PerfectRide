@using System.Security.Claims
@using PerfectRide.Data
@using PerfectRide.Services
@using PerfectRide.Helpers

@inject MileageTrackingService MileageTrackingService
@inject VehicleService VehicleService
@inject MaintenanceService MaintenanceService
@inject MileageService MileageService
@inject FuelService FuelService

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<VehicleCard> Logger


<div class="card dashboard-card vehicle-dashboard-card shadow-sm">
    <div class="card-body">

        @* Header *@
        <div class="dashboard-card-heading">
            <div>
                <p class="dashboard-card-eyebrow">Fleet</p>
                <h2 class="card-title">My Vehicles</h2>
            </div>
            <a class="dashboard-card-action" href="/authenticated/vehicles">View vehicles <span aria-hidden="true">&rarr;</span></a>
        </div>
        @* Loading, empty, or error state *@
        @if (_isLoading)
        {
            <p>Loading vehicles...</p>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <p class="mb-2">@_errorMessage</p>
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="RetryAsync">Try again</button>
            </div>
        }
        else if (_vehicles.Count == 0)
        {
            <p>You haven't added any vehicles yet.</p>
        }
        else
        {

            @* Loop through user vehicles and create a card for each vehicle.  Render the card. *@
            @foreach (var vehicle in _vehicles)
            {
                <div class="vehicle-card">
                    <div class="vehicle-card-header">
                        <strong>@vehicle.Year @vehicle.Make @vehicle.Model</strong>
                         <a href="/authenticated/expenses/@vehicle.Id">View vehicle expenses <span aria-hidden="true">&rarr;</span></a>
                    </div>

                    <div class="vehicle-card-body">

                        @* Vehicle identity info *@
                        <div class="vehicle-info">
                            @{
                                int? mileage = GetVehicleMileage(vehicle.Id);
                                int? scheduleCount = GetScheduleCount(vehicle.Id);
                                (decimal? averageFuelMileage, int? fillUps) = GetFuelStatistics(vehicle.Id);
                            }

                            @* Vehicle mileage info *@
                            <div>
                                <span class="info-label">Current Mileage: </span>
                                <NavLink href="/Authenticated/mileage">See Vehicle Mileage Records</NavLink>
                                @if (mileage.HasValue)
                                {
                                    <strong>@mileage.Value.ToString("N0") Miles</strong>
                                }
                                else
                                {
                                    <span>No Mileage Recorded</span>
                                }
                            </div>

                            @* Vehicle fuel fill-ups count. *@
                            <div>
                                <span class="info-label">Fuel fill-ups</span>
                                @if (fillUps.HasValue)
                                {
                                <strong>@fillUps entries</strong>
                                } else
                                {
                                    <span>No fill-ups recorded</span>
                                }

                            </div>

                            @* Average fuel economy calculation for vehicle *@
                            <div>
                                <span class="info-label">Average fuel economy</span>
                                @if (averageFuelMileage.HasValue)
                                {
                                <strong>@($"{averageFuelMileage:F1} MPG")</strong>
                                } else
                                {
                                    <span>Not enough information to calculate fuel mileage</span>
                                }
                            </div>

                            @* Maintenance Schedule count for vehicle *@
                            <div>
                                <span class="info-label">Maintenance Schedules</span>
                                @if (scheduleCount.HasValue)
                                {
                                <strong>@scheduleCount active</strong>
                                } else
                                {
                                    <span>Vehicle has no maintenance schedules</span>
                                }
                            </div>

                            @* Last maintenance item completed on vehicle. *@
                            <div>
                                <span class="info-label">Last Maintenance</span>
                                <strong>@GetLatestMaintenance(vehicle)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<Vehicle> _vehicles = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    private readonly Dictionary<int, int?> _vehicleMileages = new();
    private readonly Dictionary<int, int?> _scheduleCounts = new();
    private readonly Dictionary<int, (decimal? Average, int? FillUps)> _fuelStatistics = new();
    private readonly Dictionary<int, List<MaintenanceRecord>> _maintenanceRecords = new();
    private readonly FuelMileageStatistics _fuelMileageStatistics = new();

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task RetryAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        _vehicles.Clear();
        _vehicleMileages.Clear();
        _scheduleCounts.Clear();
        _fuelStatistics.Clear();
        _maintenanceRecords.Clear();

        try
        {
            @* User authorization *@
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrWhiteSpace(userId))
            {
                _errorMessage = "Unable to verify your account. Please sign in again.";
                return;
            }

            @* Load user's vehicles *@
            _vehicles = await VehicleService.GetVehiclesAsync(userId);

            @* Retrieve Maintenance schedules, fuel records, mileage records, and maintenance records for user's vehicles. *@
            foreach (Vehicle vehicle in _vehicles)
            {
                List<MaintenanceSchedule> schedules =
                    await MaintenanceService.GetMaintenanceSchedulesForVehicleAsync(vehicle.Id, userId);
                List<FuelRecord> fuelRecords =
                    await FuelService.GetFuelRecordsForVehicleAsync(vehicle.Id, userId);
                List<MileageTracking> mileageTrackings =
                    await MileageService.GetMileageForVehicle(vehicle.Id, userId);
                List<MaintenanceRecord> records =
                    await MaintenanceService.GetRecordsForVehicleAsync(vehicle.Id, userId);

                @* Count total service schedules for vehicle.  Store this count and individual vehicle's 
                maintenance records in local variable *@
                _scheduleCounts[vehicle.Id] = schedules.Count > 0 ? schedules.Count : null;
                _maintenanceRecords[vehicle.Id] = records;

                @* Calculate average fuel mileage, mileage, and total fill-ups for vehicle.  Save results in variable *@
                (decimal average, int fillUps) = _fuelMileageStatistics.GetFuelMileageStatistics(fuelRecords, mileageTrackings, userId);
                _fuelStatistics[vehicle.Id] = (average > 0 ? average : null, fillUps > 0 ? fillUps : null);
                _vehicleMileages[vehicle.Id] = await MileageTrackingService.GetCurrentVehicleMileage(vehicle.Id, userId);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load dashboard vehicle data.");
            _errorMessage = "We couldn't load your vehicles. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    @* Retrieve vehicle's highest mileage value or return null. *@
    private int? GetVehicleMileage(int vehicleId) =>
        _vehicleMileages.TryGetValue(vehicleId, out int? mileage) ? mileage : null;

    @* Retrieve a count of MaintenanceSchedules associated with a vehicle or return null *@
    private int? GetScheduleCount(int vehicleId) =>
        _scheduleCounts.TryGetValue(vehicleId, out int? count) ? count : null;

    @* Retrieve the average fuel economy and the total fill-ups count of a vehicle or return null *@
    private (decimal? Average, int? FillUps) GetFuelStatistics(int vehicleId) =>
        _fuelStatistics.TryGetValue(vehicleId, out var statistics)
            ? statistics
            : (null, null);


    @* Retrieve the latest maintenance record, format it into a string and return it, or 
    return the default string if no maintenance items are present. *@
    private string GetLatestMaintenance(Vehicle vehicle)
    {
        MaintenanceRecord? latest = _maintenanceRecords.TryGetValue(vehicle.Id, out var records)
            ? records.FirstOrDefault()
            : null;

        if (latest != null)
        {
            string returnString = $"{DisplayNameHelper.ToDisplayName(latest.MaintenanceItem)} on {latest.DatePerformed.ToShortDateString()}";  
            return returnString; 
        } else
        {
            string returnString = "No maintenance items have been recorded.";
            return returnString; 
        }
    }
}