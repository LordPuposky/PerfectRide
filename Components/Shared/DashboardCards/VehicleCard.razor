@using System.Security.Claims
@using PerfectRide.Data
@using PerfectRide.Services
@using PerfectRide.Helpers

@inject VehicleService VehicleService
@inject MaintenanceService MaintenanceService
@inject MileageService MileageService
@inject FuelService FuelService

@inject AuthenticationStateProvider AuthenticationStateProvider


<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title">My Vehicles</h1>
       <p><a class="btn btn-outline-secondary btn-sm" href="/authenticated/vehicles">&rArr; Go to Vehicles</a></p>

        @if (_isLoading)
        {
            <p>Loading vehicles...</p>
        }
        else if (_vehicles.Count == 0)
        {
            <p>You haven't added any vehicles yet.</p>
        }
        else
        {
            @foreach (var vehicle in _vehicles)
            {
                <div class="vehicle-card mb-3">
                    <div class="vehicle-card-header">
                        <strong>@vehicle.Year @vehicle.Make @vehicle.Model</strong>
                    </div>

                    <div class="vehicle-card-body">
                        <div class="vehicle-info">
                            @{
                                int? mileage = GetLatestMileage(vehicle);
                            }

                            <div>
                                <span class="info-label">Current Mileage: </span>
                                <NavLink href="/Authenticated/mileage">See Vehicle Mileage Records</NavLink>
                                @if (mileage.HasValue)
                                {
                                    <strong>@mileage.Value.ToString("N0") Miles</strong>
                                }
                                else
                                {
                                    <span>No Mileage Recorded</span>
                                }
                            </div>
                            <div>
                                <span class="info-label">Fuel fill-ups</span>
                                @if (_fillUps.HasValue)
                                {
                                <strong>@_fillUps entries</strong>
                                } else
                                {
                                    <span>No fill-ups recorded</span>
                                }

                            </div>
                            <div>
                                <span class="info-label">Average fuel economy</span>
                                @if (_averageFuelMileage.HasValue)
                                {
                                <strong>@($"{_averageFuelMileage:F1} MPG")</strong>
                                } else
                                {
                                    <span>Not enough information to calculate fuel mileage</span>
                                }
                            </div>
                            <div>
                                <span class="info-label">Maintenance Schedules</span>
                                @if (_totalSchedules.HasValue)
                                {
                                <strong>@_totalSchedules active</strong>
                                } else
                                {
                                    <span>Vehicle has no maintenance schedules</span>
                                }

                            </div>

                            <div>
                                <span class="info-label">Last Maintenance</span>
                                <strong>@GetLatestMaintenance(vehicle)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private int? _totalSchedules = null;
    private decimal? _averageFuelMileage = null;
    private int? _fillUps = null;  
    private decimal? _totalMiles = null; 
    private List<Vehicle> _vehicles = new();
    private List<MaintenanceRecord> _maintenanceRecords = new();
    private List<MileageTracking> _mileageTrackings = new(); 
    private List<FuelRecord> _fuelRecords = new(); 
    private bool _isLoading = true;

    private FuelMileageStatistics _fuelMileageStatistics = new(); 
    protected override async Task OnInitializedAsync()

    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;


        if (!string.IsNullOrEmpty(userId))
        {
            _vehicles = await VehicleService.GetVehiclesAsync(userId);
            foreach (Vehicle v in _vehicles)
            {

                List<MaintenanceSchedule> vehicleMaintenanceSchedules = await MaintenanceService.GetMaintenanceSchedulesForVehicleAsync(v.Id, userId);
                List<FuelRecord> vehicleFuelRecords = await FuelService.GetFuelRecordsForVehicleAsync(v.Id, userId);
                List<MileageTracking> vehicleMileageTrackings = await MileageService.GetMileageForVehicle(v.Id, userId);
                List<MaintenanceRecord> vehicleRecords = await MaintenanceService.GetRecordsForVehicleAsync(v.Id, userId);
                _maintenanceRecords.AddRange(vehicleRecords);
                _mileageTrackings.AddRange(vehicleMileageTrackings);
                _fuelRecords.AddRange(vehicleFuelRecords);

                (_averageFuelMileage, _fillUps) = _fuelMileageStatistics.GetFuelMileageStatistics(vehicleFuelRecords, vehicleMileageTrackings, userId);

            }
        }
    _isLoading = false;
    }


    
    int? GetLatestMileage(Vehicle vehicle)
    {
        MileageTracking? latest = _mileageTrackings.FirstOrDefault( m => m.VehicleId == vehicle.Id);
        int? mileage = latest?.Mileage;

        return mileage;
    }
    private string GetLatestMaintenance(Vehicle vehicle)
    {
        MaintenanceRecord? latest = _maintenanceRecords.FirstOrDefault(r => r.VehicleId == vehicle.Id); 

        if (latest != null)
        {
            string returnString = $"{DisplayNameHelper.ToDisplayName(latest.MaintenanceItem)} on {latest.DatePerformed.ToShortDateString()}";  
            return returnString; 
        } else
        {
            string returnString = "No maintenance items have been recorded.";
            return returnString; 
        }
    }
}