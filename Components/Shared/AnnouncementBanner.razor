
@implements IDisposable

<div class="announcement-banner @MessageType">
    @if (!string.IsNullOrWhiteSpace(CurrentMessage))
    {
        <div class="announcement-track @(IsAnimated ? "scrolling" : "")">
            <span>@CurrentMessage</span>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public List<string> Messages { get; set; } = new();

    [Parameter]
    public bool IsAnimated { get; set; }

    [Parameter]
    public string MessageType { get; set; } = "info";

    [Parameter]
    public int RotationIntervalSeconds { get; set; } = 6;

    private int _currentIndex;
    private CancellationTokenSource? _rotationCts;

    private string CurrentMessage =>
        Messages.Count > 0
            ? Messages[_currentIndex % Messages.Count]
            : Message;

    protected override void OnParametersSet()
    {
        if (Messages.Count > 1 && _rotationCts == null)
        {
            _rotationCts = new CancellationTokenSource();
            _ = RotateMessagesAsync(_rotationCts.Token);
        }
    }

 
    private async Task RotateMessagesAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(
                    TimeSpan.FromSeconds(RotationIntervalSeconds),
                    cancellationToken);

                await InvokeAsync(() =>
                {
                    if (Messages.Count > 1)
                    {
                        _currentIndex = (_currentIndex + 1) % Messages.Count;
                        StateHasChanged();
                    }
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Normal shutdown when the component is disposed.
        }
    }

   

  public void Dispose()
{
    _rotationCts?.Cancel();
    _rotationCts?.Dispose();
}

}