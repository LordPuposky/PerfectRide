@page "/about"

<PageTitle>About PerfectRide</PageTitle>

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <img src="/lib/images/perfectride-icon-final-dark.svg"
             alt="PerfectRide Logo"
             class="img-fluid mb-3"
             style="max-width: 180px;" />

        <h1>About PerfectRide</h1>
        <p class="lead">
            Your vehicles. Your information. All in one place.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="secondaryBorder rounded-3 p-4 mb-4">
                <h2>Our Purpose</h2>
                <p>
                    PerfectRide is designed to make managing your vehicles
                    easier. Whether you own one vehicle or several, keeping
                    track of important vehicle information shouldn't be
                    complicated.
                </p>
                <p>
                    PerfectRide provides a convenient place to organize
                    your vehicles and keep the information you need
                    readily accessible.
                </p>
            </div>

            <div class="secondaryBorder rounded-3 p-4 mb-4">
                <h2>Why PerfectRide?</h2>
                <p>
                    Vehicles are an important part of everyday life.
                    From routine ownership details to keeping track of
                    the vehicles you own, having organized information
                    makes managing them easier.
                </p>
                <p>
                    PerfectRide was created with simplicity and
                    convenience in mind, giving vehicle owners a
                    straightforward way to manage their information.
                </p>
            </div>

            <div class="secondaryBorder rounded-3 p-4">
                <h2>Get Started</h2>
                <p>
                    Ready to take control of your vehicle information?
                    Create an account and start using PerfectRide today!
                </p>
                <div class="text-center mt-3">
                    <a href="/account/register" class="btn btn-primary">
                        Create an Account
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>