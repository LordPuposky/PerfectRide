@page "/authenticated/mileage/history"
@using Microsoft.EntityFrameworkCore
@using PerfectRide.Data
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>Mileage History - PerfectRide</PageTitle>

<div class="container mt-4">
    @if (vehicle == null && !loadError)
    {
        <p>Loading...</p>
    }
    else if (loadError)
    {
        <div class="alert alert-danger">Something went wrong while loading the mileage history. Please try again.</div>
        <a href="/authenticated/mileage" class="btn btn-outline-secondary">Back to Vehicles</a>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Mileage History</h1>
            <a href="/authenticated/mileage" class="btn btn-outline-secondary">Back to Vehicles</a>
        </div>

        <h5 class="text-muted mb-4">@vehicle!.Year @vehicle.Make @vehicle.Model</h5>

        <a href="/authenticated/mileage/add?vehicleId=@vehicle.Id" class="btn btn-primary mb-3">Log Odometer Reading</a>

        @if (mileageRecords == null || !mileageRecords.Any())
        {
            <p class="text-muted">No mileage records yet. Click Log Odometer Reading to get started.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Mileage</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in mileageRecords)
                    {
                        <tr>
                            <td>@record.DateRecorded.ToString("MM/dd/yyyy")</td>
                            <td>@record.Mileage.ToString("N0") miles</td>
                            <td>@record.Source.ToString()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int VehicleId { get; set; }

    private Vehicle? vehicle;
    private List<MileageTracking>? mileageRecords;
    private bool loadError = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId == null)
        {
            Nav.NavigateTo("/account/login");
            return;
        }

        try
        {
            vehicle = await Db.Vehicles
                .FirstOrDefaultAsync(v => v.Id == VehicleId && v.UserId == userId);

            if (vehicle == null)
            {
                Nav.NavigateTo("/authenticated/mileage");
                return;
            }

            mileageRecords = await Db.MileageTrackings
                .Where(m => m.VehicleId == VehicleId)
                .OrderByDescending(m => m.DateRecorded)
                .ToListAsync();
        }
        catch
        {
            loadError = true;
        }
    }
}