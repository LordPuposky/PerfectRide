@page "/authenticated/mileage/add"
@using Microsoft.EntityFrameworkCore
@using PerfectRide.Data
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject MileageTrackingService MileageTrackingService

@rendermode InteractiveServer

<PageTitle>Log Odometer Reading - PerfectRide</PageTitle>

<div class="container mt-4">
    <h1>Log Odometer Reading</h1>

    @if (vehicle == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h5 class="text-muted mb-4">@vehicle.Year @vehicle.Make @vehicle.Model</h5>

        @if (latestMileage != null)
        {
            <p class="text-muted">Last recorded mileage: <strong>@latestMileage.Value.ToString("N0") miles</strong></p>
        }

        <EditForm Model="model" OnValidSubmit="HandleSubmit" FormName="add-mileage">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Date <span class="text-danger">*</span></label>
                <InputDate class="form-control" @bind-Value="model.Date" @bind-Value:format="MM/dd/yyyy"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            <div class="mb-3">
                <label class="form-label">Odometer Reading <span class="text-danger">*</span></label>
                <InputNumber class="form-control" @bind-Value="model.Mileage" placeholder="e.g. 45000" />
                @if (mileageError != null)
                {
                    <span class="text-danger">@mileageError</span>
                }
            </div>

            @if (errorMessage != null)
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }

            <button type="submit" class="btn btn-primary">Save Reading</button>
            <a href="/authenticated/mileage" class="btn btn-secondary ms-2">Cancel</a>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int VehicleId { get; set; }

    private Vehicle? vehicle;
    private int? latestMileage;
    private string? mileageError;
    private string? errorMessage;

    private MileageFormModel model = new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today)
    };

    private class MileageFormModel
    {
        public DateOnly Date { get; set; }
        public int? Mileage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId == null)
        {
            Nav.NavigateTo("/account/login");
            return;
        }

        vehicle = await Db.Vehicles
            .FirstOrDefaultAsync(v => v.Id == VehicleId && v.UserId == userId);

        if (vehicle == null)
        {
            Nav.NavigateTo("/authenticated/mileage");
            return;
        }

        var latest = await Db.MileageTrackings
            .Where(m => m.VehicleId == VehicleId)
            .OrderByDescending(m => m.DateRecorded)
            .FirstOrDefaultAsync();

        latestMileage = latest?.Mileage;
    }

  
    private async Task HandleSubmit()
    {
        mileageError = null;
        errorMessage = null;

        if (vehicle == null)
        {
            errorMessage = "The vehicle could not be found.";
            return;
        }

        if (model.Date > DateOnly.FromDateTime(DateTime.Today))
        {
            mileageError = "The date cannot be in the future.";
            return;
        }

        if (model.Mileage == null)
        {
            mileageError = "Please enter an odometer reading.";
            return;
        }

        try
        {
            await MileageTrackingService.ValidateMileageAsync(
                vehicle.Id,
                model.Date,
                model.Mileage.Value,
                null);

            var entry = new MileageTracking
            {
                VehicleId = vehicle.Id,
                DateRecorded = model.Date,
                Mileage = model.Mileage.Value,
                Source = MileageSource.Manual
            };

            Db.MileageTrackings.Add(entry);
            await Db.SaveChangesAsync();

            Nav.NavigateTo("/authenticated/mileage");
        }
        catch (ArgumentException ex)
        {
            mileageError = ex.Message;
        }
        catch
        {
            errorMessage = "Something went wrong while saving the reading. Please try again.";
        }
    }

}