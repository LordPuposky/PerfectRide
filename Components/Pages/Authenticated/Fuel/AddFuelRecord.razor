@page "/authenticated/fuel/add"
@using PerfectRide.Data
@using PerfectRide.Services
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject MileageTrackingService MileageTrackingService
@rendermode InteractiveServer

<PageTitle>Add Fuel Record</PageTitle>

<div class="container mt-4">
    <h1>Add Fuel Record</h1>

    @if (vehicle == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <h5 class="text-muted mb-4">@vehicle.Year @vehicle.Make @vehicle.Model</h5>

        <EditForm Model="fuelRecord" OnValidSubmit="HandleSubmit" FormName="add-fuel-record">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label class="form-label">Date Filled <span class="text-danger">*</span></label>
                <InputDate class="form-control" @bind-Value="fuelRecord.DateFilled" @bind-Value:format="MM/dd/yyyy"
                           max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <ValidationMessage For="() => fuelRecord.DateFilled" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Mileage <span class="text-danger">*</span></label>
                <InputNumber class="form-control" @bind-Value="currentMileage" placeholder="e.g. 45000" />
                @if (mileageError)
                {
                    <span class="text-danger">Please enter a valid mileage of 0 or greater.</span>
                }
            </div>

            <div class="mb-3">
                <label class="form-label">Gallons <span class="text-danger">*</span></label>
                <InputNumber class="form-control" @bind-Value="fuelRecord.Gallons" placeholder="e.g. 12.5" />
                <ValidationMessage For="() => fuelRecord.Gallons" class="text-danger" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price Per Gallon <span class="text-danger">*</span></label>
                <InputNumber class="form-control" @bind-Value="fuelRecord.PricePerGallon" placeholder="e.g. 3.50" />
                <ValidationMessage For="() => fuelRecord.PricePerGallon" class="text-danger" />
            </div>

            <div class="mb-3 form-check">
                <InputCheckbox class="form-check-input" @bind-Value="fuelRecord.IsFullTank" />
                <label class="form-check-label">Full Tank</label>
            </div>

            @if (errorMessage != null)
            {
                <div class="alert alert-danger mt-3">@errorMessage</div>
            }

            <button type="submit" class="btn btn-primary">Save Fuel Record</button>
            <a href="/authenticated/vehicles/@VehicleId" class="btn btn-secondary ms-2">Cancel</a>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public int VehicleId { get; set; }

    private Vehicle? vehicle;
    private FuelRecord fuelRecord = new()
    {
        DateFilled = DateOnly.FromDateTime(DateTime.Today),
        Gallons = 0,
        PricePerGallon = 0
    };
    private int? currentMileage = null;
    private bool mileageError = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId == null)
        {
            Nav.NavigateTo("/account/login");
            return;
        }

        vehicle = await Db.Vehicles
            .FirstOrDefaultAsync(v => v.Id == VehicleId && v.UserId == userId);

        if (vehicle == null)
        {
            Nav.NavigateTo("/authenticated/vehicles");
        }
    }

    private async Task HandleSubmit()
    {
        mileageError = currentMileage == null || currentMileage < 0 || currentMileage > 999999;
        if (mileageError) return;

        if (fuelRecord.DateFilled > DateOnly.FromDateTime(DateTime.Today))
        {
            errorMessage = "The date cannot be in the future.";
            return;
        }

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId == null)
        {
            Nav.NavigateTo("/account/login");
            return;
        }

        fuelRecord.VehicleId = VehicleId;
        fuelRecord.TotalCost = Math.Round(fuelRecord.Gallons * fuelRecord.PricePerGallon, 2);

        await using var transaction = await Db.Database.BeginTransactionAsync();

        try
        {
            var mileageTracking = await MileageTrackingService.AssignMileageTrackingRecord(
                VehicleId,
                fuelRecord.DateFilled,
                currentMileage!.Value,
                MileageSource.FuelRecord
            );

            if (Db.Entry(mileageTracking).State == Microsoft.EntityFrameworkCore.EntityState.Detached)
            {
                Db.MileageTrackings.Add(mileageTracking);
            }

            fuelRecord.MileageTracking = mileageTracking;
            Db.FuelRecords.Add(fuelRecord);

            await Db.SaveChangesAsync();
            await transaction.CommitAsync();

            Nav.NavigateTo($"/authenticated/vehicles/{VehicleId}");
        }
        catch
        {
            await transaction.RollbackAsync();
            errorMessage = "Something went wrong while saving the fuel record. Please try again.";
        }
    }
}