@page "/authenticated/dashboard"
@using PerfectRide.Components.Pages.Authenticated.Maintenance
@using PerfectRide.Components.Shared.DashboardCards


@* Rotating Maintenance message banner *@
<AnnouncementBanner
    Messages="_maintenanceMessages"
    MessageType="warning"
    RotationIntervalSeconds="6" />

@* Page Header and title *@
<div class="dashboard-page">
    <header class="dashboard-header">
        <div>
            <p class="dashboard-eyebrow">PerfectRide</p>
            <h1>Dashboard</h1>
        </div>
    </header>

@* Render vehicle and maintenance cards *@
    <div class="dashboard-grid">
        <section class="dashboard-section dashboard-section-vehicles">
        <VehicleCard/>
        </section>
        <section class="dashboard-section dashboard-section-maintenance">
        <MaintenanceCard OnMessagesGenerated="HandleMessagesGenerated" />
        </section>
    </div>
</div>

@code{

    private List<string> _maintenanceMessages = new();

    @*Retrieve messages from Maintenance card component and display on the Maintenance Banner*@
    private void HandleMessagesGenerated(List<string> messages)
    {
        _maintenanceMessages = messages?.Where(message => !string.IsNullOrWhiteSpace(message)).ToList()
            ?? new List<string>();
    }
        
}