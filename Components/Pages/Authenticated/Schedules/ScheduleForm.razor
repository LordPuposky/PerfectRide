@using PerfectRide.Data
@using PerfectRide.Helpers
@using PerfectRide.Models

@* Shared form used by the Add and Edit schedule pages. *@

<EditForm EditContext="_editContext" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    <p id="interval-help">Fill in one or both intervals. The service is due at whichever comes first.</p>

    <div class="row g-3">
        <div class="col-12">
            <label for="schedule-item" class="form-label">Service (required)</label>
            <InputSelect id="schedule-item" class="form-select" @bind-Value="Model.MaintenanceItem">
                <option value="">Choose a service...</option>
                @foreach (var item in Enum.GetValues<MaintenanceItem>())
                {
                    <option value="@item">@DisplayNameHelper.ToDisplayName(item)</option>
                }
            </InputSelect>
            <ValidationMessage For="() => Model.MaintenanceItem" class="text-danger" />
        </div>

        <div class="col-md-6">
            <label for="interval-mileage" class="form-label">Every how many miles</label>
            <InputNumber id="interval-mileage" class="form-control" @bind-Value="Model.IntervalMileage"
                         min="1" max="100000" aria-describedby="interval-help" />
            <ValidationMessage For="() => Model.IntervalMileage" class="text-danger" />
        </div>

        <div class="col-md-6">
            <label for="interval-months" class="form-label">Every how many months</label>
            <InputNumber id="interval-months" class="form-control" @bind-Value="Model.IntervalMonths"
                         min="1" max="24" aria-describedby="interval-help" />
            <ValidationMessage For="() => Model.IntervalMonths" class="text-danger" />
        </div>

        <div class="col-12">
            <label for="schedule-description" class="form-label">Notes</label>
            <InputTextArea id="schedule-description" class="form-control" rows="3" @bind-Value="Model.Description"
                           maxlength="500" aria-describedby="schedule-description-help" />
            <div id="schedule-description-help" class="form-text">Required when the service is "Other".</div>
            <ValidationMessage For="() => Model.Description" class="text-danger" />
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : SubmitText)
        </button>
        <a class="btn btn-outline-dark" href="@CancelUrl">Cancel</a>
    </div>
</EditForm>

@code {
    [Parameter, EditorRequired]
    public ScheduleFormModel Model { get; set; } = default!;

    [Parameter]
    public EventCallback OnValidSubmit { get; set; }

    [Parameter]
    public string SubmitText { get; set; } = "Save";

    [Parameter, EditorRequired]
    public string CancelUrl { get; set; } = "/authenticated/schedules";

    [Parameter]
    public bool IsSaving { get; set; }

    [Parameter]
    public string? ErrorMessage { get; set; }

    private EditContext? _editContext;
    private ValidationMessageStore? _ruleMessages;
    private bool _submitAttempted;

    protected override void OnParametersSet()
    {
        // Create the EditContext once per model so typed values survive re-renders.
        if (_editContext is null || !ReferenceEquals(_editContext.Model, Model))
        {
            _editContext = new EditContext(Model);
            _ruleMessages = new ValidationMessageStore(_editContext);

            // On submit: check the rules together with the data annotations.
            _editContext.OnValidationRequested += (_, _) =>
            {
                _submitAttempted = true;
                CheckRules();
            };

            // After the first submit, update the rule messages while the user fixes the form,
            // so no old message stays on screen.
            _editContext.OnFieldChanged += (_, _) =>
            {
                if (_submitAttempted)
                {
                    CheckRules();
                    _editContext.NotifyValidationStateChanged();
                }
            };
        }
    }

    private void CheckRules()
    {
        _ruleMessages!.Clear();
        foreach (var (fieldName, message) in Model.GetRuleErrors())
        {
            _ruleMessages.Add(_editContext!.Field(fieldName), message);
        }
    }

    private Task HandleValidSubmit() => OnValidSubmit.InvokeAsync();
}
